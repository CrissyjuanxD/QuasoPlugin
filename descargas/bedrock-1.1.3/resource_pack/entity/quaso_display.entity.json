      "scripts": {
        "initialize": [
          "v.seq = q.property('quaso:revision');",
          "v.elapsed = 1000;",
          "v.t_x=q.property('quaso:t_x');v.old_t_x=v.t_x;",
          "v.t_y=q.property('quaso:t_y');v.old_t_y=v.t_y;",
          "v.t_z=q.property('quaso:t_z');v.old_t_z=v.t_z;",
          "v.l_x=q.property('quaso:l_x');v.old_l_x=v.l_x;",
          "v.l_y=q.property('quaso:l_y');v.old_l_y=v.l_y;",
          "v.l_z=q.property('quaso:l_z');v.old_l_z=v.l_z;",
          "v.s_x=q.property('quaso:s_x');v.old_s_x=v.s_x;",
          "v.s_y=q.property('quaso:s_y');v.old_s_y=v.s_y;",
          "v.s_z=q.property('quaso:s_z');v.old_s_z=v.s_z;",
          "v.r_x=q.property('quaso:r_x');v.old_r_x=v.r_x;",
          "v.r_y=q.property('quaso:r_y');v.old_r_y=v.r_y;",
          "v.r_z=q.property('quaso:r_z');v.old_r_z=v.r_z;"
        ],
        "pre_animation": [
          "(v.seq != q.property('quaso:revision')) ? { v.old_t_x=v.t_x;v.old_t_y=v.t_y;v.old_t_z=v.t_z;v.old_l_x=v.l_x;v.old_l_y=v.l_y;v.old_l_z=v.l_z;v.old_s_x=v.s_x;v.old_s_y=v.s_y;v.old_s_z=v.s_z;v.old_r_x=v.r_x;v.old_r_y=v.r_y;v.old_r_z=v.r_z;v.seq=q.property('quaso:revision');v.elapsed=0;};",
          "v.elapsed=v.elapsed+q.delta_time;",
          "v.blend=math.min(1,v.elapsed/math.max(.001,q.property('quaso:duration')));",
          "v.t_x=math.lerp(v.old_t_x,q.property('quaso:t_x'),v.blend);",
          "v.t_y=math.lerp(v.old_t_y,q.property('quaso:t_y'),v.blend);",
          "v.t_z=math.lerp(v.old_t_z,q.property('quaso:t_z'),v.blend);",
          "v.l_x=math.lerprotate(v.old_l_x,q.property('quaso:l_x'),v.blend);",
          "v.l_y=math.lerprotate(v.old_l_y,q.property('quaso:l_y'),v.blend);",
          "v.l_z=math.lerprotate(v.old_l_z,q.property('quaso:l_z'),v.blend);",
          "v.s_x=math.lerp(v.old_s_x,q.property('quaso:s_x'),v.blend);",
          "v.s_y=math.lerp(v.old_s_y,q.property('quaso:s_y'),v.blend);",
          "v.s_z=math.lerp(v.old_s_z,q.property('quaso:s_z'),v.blend);",
          "v.r_x=math.lerprotate(v.old_r_x,q.property('quaso:r_x'),v.blend);",
          "v.r_y=math.lerprotate(v.old_r_y,q.property('quaso:r_y'),v.blend);",
          "v.r_z=math.lerprotate(v.old_r_z,q.property('quaso:r_z'),v.blend);"
        ],
        "animate": [
          "transform"
        ]
      },
