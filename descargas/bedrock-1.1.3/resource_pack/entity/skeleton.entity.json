    "description": {
      "identifier": "minecraft:skeleton",
      "min_engine_version": "1.8.0",
      "materials": {
        "default": "skeleton",
        "quaso": "entity_alphatest",
        "quaso_glow": "entity_emissive_alpha"
      },
      "textures": {
        "default": "textures/entity/skeleton/skeleton",
        "skeleton3": "textures/entity/quaso/skeleton3",
        "skeleton3_e": "textures/entity/quaso/skeleton3_e",
        "skeleton4": "textures/entity/quaso/skeleton4",
        "skeleton4_e": "textures/entity/quaso/skeleton4_e"
      },
      "geometry": {
        "default": "geometry.skeleton.v1.8",
